[Unit]
Description=exitnode connection limits
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/nft delete table inet exitnode_guard 2>/dev/null; /usr/sbin/nft -f /etc/exitnode/guard.nft'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
