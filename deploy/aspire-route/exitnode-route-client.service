[Unit]
Description=Exitnode authenticated transport to owner node
BindsTo=exitnode-route.service
PartOf=exitnode-route.service
After=exitnode-route.service

[Service]
Type=exec
DynamicUser=yes
EnvironmentFile=/etc/exitnode-route/route.env
LoadCredential=access-key:/etc/exitnode-route/access-key
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ExecStart=/usr/local/lib/exitnode-route/client client -socks-only -tls -server ${EXITNODE_ROUTE_RELAY} -key-file %d/access-key -listen 127.0.0.1:108
Restart=on-failure
RestartSec=3s
